# Copy to .env (`make dev` does this the first time) and fill in.

# Passwords for admin mode (tap 囍 five times on the language screen, then type one).
#   root: everything (guests, groups, RSVPs, sent status, import, links)
#   link: can only see the groups and copy their links
# They must be different. A value here replaces the stored password each time the site starts;
# leave it blank to keep whatever was set with `make set-password ROLE=root|link`.
# Wrap a password in single quotes if it contains a $ sign.
ROOT_ADMIN_PASSWORD=
LINK_ADMIN_PASSWORD=

# The address guests use, e.g. https://yourdomain.com (no trailing slash). Copied links start
# with this. Leave blank to use whatever address the admin has open.
PUBLIC_URL=

# Cloudflare tunnel token (Zero Trust > Networks > Tunnels > your tunnel > the token in the
# Docker command). When set, `make up` also runs cloudflared in Docker; give the tunnel a public
# hostname whose service is http://web:80. Leave blank if cloudflared runs on this machine
# outside Docker; point that one at http://localhost:8080 instead.
CLOUDFLARE_TUNNEL_TOKEN=

# Where the site listens on this machine. Use WEB_BIND=0.0.0.0 to open it from a phone on the same
# Wi-Fi while testing.
WEB_PORT=8080
WEB_BIND=127.0.0.1

# How long admin mode stays signed in on a device, in hours.
SESSION_HOURS=72
